NEXT_PUBLIC_API_URL=http://localhost:8000
# Only relevant when running via Docker Compose (see infra/docker-compose.yml) —
# server-side and browser-side fetches then run in different network
# namespaces and need different URLs. Running the frontend directly on the
# host (this file's use case), both are the same, so this only needs to be
# set if you want to be explicit; it otherwise defaults to the value above.
NEXT_PUBLIC_API_URL_BROWSER=http://localhost:8000
