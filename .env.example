# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
POSTGRES_USER=sports
POSTGRES_PASSWORD=sports
POSTGRES_DB=sports_prediction
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://sports:sports@localhost:5432/sports_prediction

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- MLflow ---
MLFLOW_TRACKING_URI=./mlruns

# --- External data sources ---
# The Odds API: https://the-odds-api.com/ (free tier available; used for live/near-term MLB odds)
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# MLB Stats API is public and requires no key: https://statsapi.mlb.com/api/v1
MLB_STATS_API_BASE_URL=https://statsapi.mlb.com/api/v1

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
